# Copia questo file in .env e compila i valori reali. Non committare mai .env.

# Facoltativa: senza questa chiave viene usata la site key di test Cloudflare
# (sempre superata), utile in sviluppo locale.
VITE_TURNSTILE_SITE_KEY=

# Stesso Client ID / Services ID configurati nel backend (.env root).
# Se assenti, i rispettivi bottoni di login social non vengono renderizzati.
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=

# Publishable key (pk_test_... / pk_live_...) dallo stesso account Stripe della
# STRIPE_SECRET_KEY nel backend (.env root) — Dashboard > Developers > API keys.
# Necessaria per il checkout con carta nella pagina "Acquista Crediti".
VITE_STRIPE_PUBLISHABLE_KEY=
