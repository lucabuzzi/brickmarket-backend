exports[`users GET /users/:id/activity 1`] = `
{
  "body": "{"sessionCount":4,"totalTimeSeconds":300,"totalPageviews":12,"firstSeenAt":"f","lastSeenAt":"l","topPages":[{"path":"/","views":5}]}",
  "status": 200,
  "trace": [
    [
      "query",
      "SELECT COUNT(*)::int AS session_count, COALESCE(SUM(duration_seconds), 0)::int AS total_time_seconds, MIN(started_at) AS first_seen_at, MAX(last_seen_at) AS last_seen_at FROM analytics_sessions WHERE user_id = $1",
      [
        "u1",
      ],
    ],
    [
      "query",
      "SELECT COUNT(*)::int AS total_pageviews FROM analytics_pageviews p JOIN analytics_sessions s ON s.id = p.session_id WHERE s.user_id = $1",
      [
        "u1",
      ],
    ],
    [
      "query",
      "SELECT p.path, COUNT(*)::int AS views FROM analytics_pageviews p JOIN analytics_sessions s ON s.id = p.session_id WHERE s.user_id = $1 GROUP BY p.path ORDER BY views DESC LIMIT 10",
      [
        "u1",
      ],
    ],
  ],
}
`;

