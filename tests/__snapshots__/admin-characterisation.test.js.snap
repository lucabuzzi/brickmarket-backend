exports[`users GET /users/detailed country, role, page and limit 1`] = `
{
  "body": "{"users":[{"id":"u1"}],"pagination":{"total":41,"page":3,"pages":9},"geoData":[{"country":"IT","user_count":3}]}",
  "status": 200,
  "trace": [
    [
      "query",
      "SELECT COUNT(*) FROM users WHERE 1=1 AND UPPER(address_country) = UPPER($1) AND role = $2",
      [
        "it",
        "admin",
      ],
    ],
    [
      "query",
      "SELECT u.id, u.username, u.email, u.address_country, u.created_at, u.role, u.is_pro, u.is_verified, u.is_active, u.rating_avg, u.sales_count, u.rating_count, u.seller_type, u.company_name, (SELECT COUNT(*) FROM orders o WHERE o.buyer_id = u.id AND o.status = 'completed')::int as total_purchases, (SELECT COUNT(*) FROM orders o WHERE o.seller_id = u.id AND o.status = 'completed')::int as total_sales, (SELECT COUNT(*) FROM listings l WHERE l.seller_id = u.id AND l.type = 'auction')::int as auctions_created, (SELECT COUNT(*) FROM bids b WHERE b.bidder_id = u.id)::int as total_bids, (SELECT COUNT(*) FROM bids b WHERE b.bidder_id = u.id AND b.is_winning = true)::int as auctions_won FROM users u WHERE 1=1 AND UPPER(address_country) = UPPER($1) AND role = $2 ORDER BY u.created_at DESC LIMIT $3 OFFSET $4",
      [
        "it",
        "admin",
        "5",
        10,
      ],
    ],
    [
      "query",
      "SELECT UPPER(address_country) as country, COUNT(*)::int as user_count FROM users WHERE address_country IS NOT NULL GROUP BY UPPER(address_country)",
      undefined,
    ],
  ],
}
`;

