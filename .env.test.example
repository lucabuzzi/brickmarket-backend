# Copia questo file in .env.test e compila con i valori del DB DI TEST
# (un progetto Supabase separato — vedi le istruzioni "DB DI TEST" nella
# conversazione/PR che ha introdotto questo file). Non committare mai
# .env.test, e non incollarci mai la DATABASE_URL di produzione: se il suo
# host non è anche aggiunto a tests/config/allowedTestHosts.js, i test si
# rifiuteranno comunque di partire — ma il file va comunque tenuto separato
# per evitare confusione con l'ambiente reale.
#
# Solo le variabili che i test usano davvero sono elencate qui; il resto
# (Stripe, Cloudinary, ecc.) può restare vuoto per i test coperti oggi.

DATABASE_URL=
JWT_SECRET=
NODE_ENV=development
