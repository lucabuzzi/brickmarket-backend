# Copia questo file in .env e compila i valori reali. Non committare mai .env.

PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

DATABASE_URL=
JWT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_PERCENT=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=

REBRICKABLE_API_KEY=
SENDGRID_API_KEY=
FROM_EMAIL=
# Opzionale: indirizzo a cui arrivano le risposte degli utenti alle email (Reply-To), es. la tua casella personale
REPLY_TO_EMAIL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

TURNSTILE_SECRET_KEY=

# --- Google OAuth 2.0 / OIDC (Sign in with Google) ---
GOOGLE_CLIENT_ID=

# --- Apple Sign-In ---
APPLE_CLIENT_ID=              # Services ID, NON il Bundle ID dell'app — unica var richiesta dalla verifica id_token attuale
# APPLE_TEAM_ID / APPLE_KEY_ID / APPLE_PRIVATE_KEY_PATH (.p8) non sono ancora
# usate: servono solo se in futuro si implementa refresh/revoca token via
# server-to-server client_secret JWT, non fatto in questa integrazione.

# --- Gemini (riconoscimento carte One Piece dalla foto + traduzioni) ---
# Chiave da Google AI Studio, limitata alla sola "Generative Language API". Sul piano gratuito Google può usare
# i dati inviati: prima di aprire il riconoscimento agli utenti attivare la fatturazione sul progetto.
GEMINI_API_KEY=
# GEMINI_VISION_MODEL=gemini-3.1-flash-lite   # facoltativa, è il valore predefinito
# Il riconoscimento è visibile ai venditori solo con CARD_RECOGNITION_ENABLED=1 (oltre alla chiave): lasciarlo
# spento su Render finché la fatturazione Gemini non è attiva.
# CARD_RECOGNITION_ENABLED=1
# Foto per venditore all'ora / al giorno, e per tutto il sito al giorno (predefiniti 20 / 60 / 1000)
# CARD_RECOGNIZE_HOURLY=20
# CARD_RECOGNIZE_DAILY=60
# CARD_RECOGNIZE_SITE_DAILY=1000
